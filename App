<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#111827">
<title>EntregasMaz</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #0d1117;
  --ink2: #1c2333;
  --ink3: #2d3748;
  --muted: #6b7280;
  --muted2: #9ca3af;
  --line: #e5e7eb;
  --line2: #f3f4f6;
  --white: #ffffff;
  --surface: #f9fafb;

–accent: #f59e0b;
–accent-dim: #fef3c7;
–accent-dark: #d97706;

–blue: #2563eb;
–blue-dim: #eff6ff;
–green: #059669;
–green-dim: #ecfdf5;
–red: #dc2626;
–red-dim: #fef2f2;
–orange: #ea580c;
–orange-dim: #fff7ed;

–r: 14px;
–rs: 9px;
–shadow: 0 1px 4px rgba(0,0,0,.07), 0 4px 16px rgba(0,0,0,.06);
–shadow-lg: 0 8px 32px rgba(0,0,0,.12);
}

- { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

body {
font-family: ‘Outfit’, sans-serif;
background: var(–surface);
color: var(–ink);
min-height: 100vh;
max-width: 440px;
margin: 0 auto;
position: relative;
overflow-x: hidden;
}

/* ── HEADER ── */
.topbar {
background: var(–ink);
color: white;
padding: 14px 18px 12px;
display: flex;
align-items: center;
justify-content: space-between;
position: sticky; top: 0; z-index: 200;
}
.topbar-brand { display: flex; align-items: center; gap: 10px; }
.topbar-logo {
width: 34px; height: 34px; background: var(–accent);
border-radius: 9px; display: flex; align-items: center; justify-content: center;
font-size: 17px; flex-shrink: 0;
}
.topbar-name { font-size: 17px; font-weight: 800; letter-spacing: -.3px; }
.topbar-sub { font-size: 10px; color: rgba(255,255,255,.45); font-weight: 400; margin-top: 1px; }
.mode-toggle {
display: flex; background: rgba(255,255,255,.1); border-radius: 8px; overflow: hidden; gap: 0;
}
.mode-btn {
padding: 5px 12px; font-size: 11px; font-weight: 700; font-family: ‘Outfit’, sans-serif;
border: none; background: transparent; color: rgba(255,255,255,.5);
cursor: pointer; transition: all .2s; letter-spacing: .3px;
}
.mode-btn.active { background: var(–accent); color: var(–ink); border-radius: 7px; }

/* ── SCREENS ── */
.view { display: none; padding: 16px 14px 100px; }
.view.show { display: block; }

/* ── CARDS ── */
.card {
background: var(–white);
border-radius: var(–r);
border: 1px solid var(–line);
box-shadow: var(–shadow);
margin-bottom: 12px;
overflow: hidden;
}
.card-head {
padding: 13px 15px 11px;
border-bottom: 1px solid var(–line2);
display: flex; align-items: center; gap: 10px;
}
.card-ico {
width: 34px; height: 34px; border-radius: 9px;
display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;
}
.card-title { font-size: 14px; font-weight: 700; }
.card-desc { font-size: 11px; color: var(–muted); margin-top: 1px; }
.card-body { padding: 14px 15px; }

/* ── UPLOAD ── */
.drop-zone {
border: 2px dashed var(–line);
border-radius: var(–rs);
padding: 24px 14px;
text-align: center;
cursor: pointer;
transition: all .2s;
background: var(–surface);
}
.drop-zone:hover { border-color: var(–accent); background: var(–accent-dim); }
.drop-zone.active-drop { border-color: var(–accent); background: var(–accent-dim); }
.dz-icon { font-size: 28px; margin-bottom: 8px; }
.dz-title { font-size: 13px; font-weight: 700; color: var(–ink3); margin-bottom: 3px; }
.dz-sub { font-size: 11px; color: var(–muted2); }

/* ── ANALYZING ── */
.pill {
display: inline-flex; align-items: center; gap: 6px;
padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700;
}
.pill-amber { background: var(–accent-dim); color: var(–accent-dark); border: 1px solid #fcd34d; }
.pill-green { background: var(–green-dim); color: var(–green); border: 1px solid #6ee7b7; }
.pill-blue  { background: var(–blue-dim);  color: var(–blue);  border: 1px solid #bfdbfe; }
.pill-red   { background: var(–red-dim);   color: var(–red);   border: 1px solid #fca5a5; }
.spin { width: 11px; height: 11px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: spin .6s linear infinite; display: inline-block; }

/* ── EXTRACTED INFO ── */
.extract-box {
margin-top: 12px; padding: 13px 14px;
background: var(–green-dim); border: 1px solid #a7f3d0;
border-radius: var(–rs); display: none; animation: fadeUp .3s ease;
}
.extract-box.show { display: block; }
.extract-label { font-size: 10px; font-weight: 800; color: var(–green); letter-spacing: .8px; text-transform: uppercase; margin-bottom: 8px; }
.extract-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.extract-item { }
.extract-key { font-size: 10px; color: var(–muted); font-weight: 500; }
.extract-val { font-size: 13px; font-weight: 700; color: var(–ink); margin-top: 1px; }

/* ── FORM ── */
.form-row { margin-bottom: 12px; }
.label { font-size: 11px; font-weight: 700; color: var(–muted); letter-spacing: .5px; text-transform: uppercase; margin-bottom: 5px; display: block; }
.input {
width: 100%; padding: 10px 13px; border: 1.5px solid var(–line);
border-radius: var(–rs); font-size: 14px; font-family: ‘Outfit’, sans-serif;
color: var(–ink); background: var(–white); transition: border-color .15s;
-webkit-appearance: none;
}
.input:focus { outline: none; border-color: var(–accent); }
.input::placeholder { color: var(–muted2); }

/* ── BUTTONS ── */
.btn {
width: 100%; padding: 13px; border-radius: var(–rs);
font-size: 14px; font-weight: 700; font-family: ‘Outfit’, sans-serif;
border: none; cursor: pointer; transition: all .15s;
display: flex; align-items: center; justify-content: center; gap: 7px;
}
.btn:active { transform: scale(.98); }
.btn-amber { background: var(–accent); color: var(–ink); box-shadow: 0 4px 14px rgba(245,158,11,.3); }
.btn-amber:disabled { background: var(–line); color: var(–muted2); box-shadow: none; cursor: not-allowed; transform: none; }
.btn-green { background: var(–green); color: white; box-shadow: 0 4px 14px rgba(5,150,105,.25); }
.btn-outline { background: white; color: var(–ink); border: 1.5px solid var(–line); }
.btn-ghost { background: transparent; color: var(–muted); border: none; font-size: 12px; padding: 8px; width: auto; }
.btn-row { display: flex; gap: 8px; }
.btn-back { flex: 0 0 44px; padding: 13px 0; width: 44px; background: white; border: 1.5px solid var(–line); color: var(–muted); border-radius: var(–rs); font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all .15s; }
.btn-back:active { transform: scale(.97); }

/* ── QUEUE LIST ── */
.queue-header {
display: flex; align-items: center; justify-content: space-between;
margin-bottom: 10px;
}
.section-title { font-size: 11px; font-weight: 800; color: var(–muted); letter-spacing: .8px; text-transform: uppercase; }
.queue-count {
font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 20px;
background: var(–accent-dim); color: var(–accent-dark);
}

.queue-item {
background: var(–white); border: 1px solid var(–line); border-radius: var(–r);
padding: 13px 14px; margin-bottom: 9px; box-shadow: var(–shadow);
display: flex; align-items: center; gap: 12px;
animation: fadeUp .25s ease both;
}
.qi-dot {
width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.qi-info { flex: 1; min-width: 0; }
.qi-client { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.qi-meta { font-size: 11px; color: var(–muted); margin-top: 2px; }
.qi-factura { font-family: ‘JetBrains Mono’, monospace; font-size: 11px; color: var(–muted2); margin-top: 1px; }
.qi-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
.qi-del { background: none; border: none; font-size: 16px; color: var(–muted2); cursor: pointer; padding: 2px; }

/* ── STATUS BADGES ── */
.status {
font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 20px; letter-spacing: .3px; text-transform: uppercase;
}
.status-pending { background: var(–accent-dim); color: var(–accent-dark); }
.status-done    { background: var(–green-dim);  color: var(–green); }

/* ── DRIVER DELIVERY ITEM ── */
.dlv-item {
background: var(–white); border: 1px solid var(–line); border-radius: var(–r);
margin-bottom: 9px; box-shadow: var(–shadow); overflow: hidden;
cursor: pointer; transition: all .15s;
}
.dlv-item:active { transform: scale(.99); }
.dlv-item.done { opacity: .65; }
.dlv-top { padding: 13px 14px; display: flex; align-items: center; gap: 12px; }
.dlv-num {
width: 32px; height: 32px; border-radius: 8px; background: var(–ink2);
color: white; display: flex; align-items: center; justify-content: center;
font-size: 13px; font-weight: 800; flex-shrink: 0;
}
.dlv-num.done { background: var(–green); }
.dlv-client { font-size: 15px; font-weight: 700; }
.dlv-addr { font-size: 11px; color: var(–muted); margin-top: 2px; }
.dlv-fac { font-family: ‘JetBrains Mono’, monospace; font-size: 10px; color: var(–muted2); margin-top: 2px; }
.dlv-arrow { margin-left: auto; color: var(–muted2); font-size: 18px; }

/* ── SIGN FLOW ── */
.sig-wrap { position: relative; }
#sigCanvas {
width: 100%; height: 170px; border: 1.5px solid var(–line); border-radius: var(–rs);
background: white; display: block; cursor: crosshair; touch-action: none;
}
.sig-hint {
position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
text-align: center; pointer-events: none; opacity: .35;
}
.sig-hint-icon { font-size: 26px; }
.sig-hint-text { font-size: 11px; color: var(–muted); font-weight: 600; margin-top: 4px; }
.sig-bar { display: flex; justify-content: space-between; align-items: center; margin-top: 5px; }
.sig-clear { font-size: 11px; font-weight: 700; color: var(–red); background: none; border: none; cursor: pointer; padding: 4px 6px; }

/* ── PROGRESS BAR ── */
.progress-wrap { background: var(–line2); border-radius: 10px; height: 6px; overflow: hidden; margin-bottom: 16px; }
.progress-bar { height: 100%; background: var(–accent); border-radius: 10px; transition: width .4s ease; }

/* ── EMPTY ── */
.empty { text-align: center; padding: 48px 20px; }
.empty-ico { font-size: 44px; opacity: .25; margin-bottom: 12px; }
.empty-title { font-size: 15px; font-weight: 700; color: var(–muted); margin-bottom: 5px; }
.empty-sub { font-size: 12px; color: var(–muted2); }

/* ── SUCCESS OVERLAY ── */
.success-overlay {
display: none; position: fixed; inset: 0; background: rgba(255,255,255,.97);
z-index: 500; flex-direction: column; align-items: center; justify-content: center; padding: 28px;
text-align: center;
}
.success-overlay.show { display: flex; animation: fadeIn .3s ease; }
.so-check {
width: 72px; height: 72px; background: var(–green); border-radius: 50%;
display: flex; align-items: center; justify-content: center; font-size: 32px;
margin-bottom: 18px; box-shadow: 0 8px 24px rgba(5,150,105,.3);
animation: popIn .35s ease .05s both;
}
.so-title { font-size: 24px; font-weight: 900; margin-bottom: 6px; letter-spacing: -.3px; }
.so-sub { font-size: 13px; color: var(–muted); margin-bottom: 22px; line-height: 1.55; }
.so-receipt {
background: var(–surface); border: 1px solid var(–line); border-radius: var(–r);
padding: 14px; width: 100%; max-width: 320px; margin-bottom: 22px; text-align: left;
}
.so-row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px solid var(–line2); font-size: 12px; }
.so-row:last-child { border: none; }
.so-key { color: var(–muted); }
.so-val { font-weight: 700; text-align: right; }

/* ── TOAST ── */
.toast {
position: fixed; bottom: 88px; left: 50%; transform: translateX(-50%) translateY(60px);
background: var(–ink); color: white; padding: 10px 18px; border-radius: 24px;
font-size: 13px; font-weight: 600; z-index: 999; opacity: 0; transition: all .28s ease;
white-space: nowrap; pointer-events: none;
}
.toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
.toast.ok { background: var(–green); }
.toast.err { background: var(–red); }

/* ── BOTTOM NAV ── */
.bnav {
position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
width: 100%; max-width: 440px; background: var(–white);
border-top: 1px solid var(–line); display: flex; padding: 6px 0 10px; z-index: 100;
}
.bnav-item {
flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
font-size: 10px; font-weight: 700; color: var(–muted2); cursor: pointer;
border: none; background: none; padding: 4px; transition: color .2s; letter-spacing: .3px;
text-transform: uppercase;
}
.bnav-item.on { color: var(–accent-dark); }
.bnav-icon { font-size: 20px; }

/* ── ANIMATIONS ── */
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes popIn { from { transform: scale(.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }

/* ── MISC ── */
.divider { height: 1px; background: var(–line2); margin: 14px 0; }
.mono { font-family: ‘JetBrains Mono’, monospace; }
.text-muted { color: var(–muted); }
.text-sm { font-size: 12px; }
.mt8 { margin-top: 8px; }
.mt12 { margin-top: 12px; }

/* summary detail in sign flow */
.sign-summary {
background: var(–surface); border: 1px solid var(–line); border-radius: var(–rs);
padding: 12px 14px; margin-bottom: 14px;
}
.ss-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 12px; border-bottom: 1px solid var(–line2); }
.ss-row:last-child { border: none; }
.ss-k { color: var(–muted); }
.ss-v { font-weight: 700; }

/* stats row */
.stats-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 14px; }
.stat-box { background: white; border: 1px solid var(–line); border-radius: var(–rs); padding: 12px 10px; text-align: center; box-shadow: var(–shadow); }
.stat-n { font-size: 26px; font-weight: 900; letter-spacing: -.5px; }
.stat-l { font-size: 10px; color: var(–muted); font-weight: 600; text-transform: uppercase; letter-spacing: .4px; margin-top: 2px; }
</style>

</head>
