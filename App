// ══════════════════════════════════════
// SIGNATURE PAD
// ══════════════════════════════════════
function initSigPad() {
  const canvas = document.getElementById('sigCanvas');
  const ctx = canvas.getContext('2d');

  // Resize canvas to actual CSS size
  function resize() {
    const r = canvas.getBoundingClientRect();
    canvas.width = r.width * window.devicePixelRatio;
    canvas.height = r.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }
  resize();
  window.addEventListener('resize', resize);

  let drawing = false, lx = 0, ly = 0;

  function pos(e) {
    const r = canvas.getBoundingClientRect();
    const src = e.touches ? e.touches[0] : e;
    return { x: src.clientX - r.left, y: src.clientY - r.top };
  }

  canvas.addEventListener('mousedown', e => { drawing = true; const p = pos(e); lx=p.x; ly=p.y; hideSigHint(); });
  canvas.addEventListener('touchstart', e => { e.preventDefault(); drawing = true; const p = pos(e); lx=p.x; ly=p.y; hideSigHint(); }, { passive: false });
  canvas.addEventListener('mousemove', e => { if (!drawing) return; draw(ctx, pos(e), {x:lx,y:ly}); const p = pos(e); lx=p.x; ly=p.y; });
  canvas.addEventListener('touchmove', e => { e.preventDefault(); if (!drawing) return; draw(ctx, pos(e), {x:lx,y:ly}); const p = pos(e); lx=p.x; ly=p.y; }, { passive: false });
  canvas.addEventListener('mouseup', () => { drawing = false; captureSig(canvas); });
  canvas.addEventListener('touchend', () => { drawing = false; captureSig(canvas); });
}

function draw(ctx, curr, last) {
  ctx.beginPath();
  ctx.moveTo(last.x, last.y);
  ctx.lineTo(curr.x, curr.y);
  ctx.strokeStyle = '#0d1117';
  ctx.lineWidth = 2.2;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.stroke();
}

function hideSigHint() {
  document.getElementById('sigHint').style.display = 'none';
}

function captureSig(canvas) {
  sigData = canvas.toDataURL();
  hasSig = true;
  document.getElementById('sigStatus').textContent = '✅ Firma capturada';
  document.getElementById('sigStatus').style.color = 'var(--green)';
}

function clearSig() {
  const canvas = document.getElementById('sigCanvas');
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  hasSig = false; sigData = null;
  document.getElementById('sigHint').style.display = 'block';
  document.getElementById('sigStatus').textContent = 'Sin firma';
  document.getElementById('sigStatus').style.color = '';
}

// ══════════════════════════════════════
// TOAST
// ══════════════════════════════════════
function toast(msg, type = '') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = `toast ${type} show`;
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 2800);
}
</script>

