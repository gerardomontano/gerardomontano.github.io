  <div class="so-receipt" id="so-receipt"></div>
  <div style="display:flex; gap:10px; width:100%; max-width:320px; flex-direction:column">
    <button class="btn btn-green" onclick="downloadReceipt()">⬇️ Descargar comprobante PDF</button>
    <button class="btn btn-outline" onclick="closeSuccess()">← Volver a la ruta</button>
  </div>
</div>

<!-- TOAST -->

<div class="toast" id="toast"></div>

<script>
// ══════════════════════════════════════
// STATE
// ══════════════════════════════════════
let queue    = JSON.parse(localStorage.getItem('emaz_queue')    || '[]'); // pending deliveries
let history  = JSON.parse(localStorage.getItem('emaz_history')  || '[]');
let mode     = 'oficina'; // oficina | repartidor

// temp state for upload
let pendingExtract = null; // { client, factura, address, raw }

// temp state for signing
let activeDelivery = null;
let hasSig = false;
let sigData = null;

// ══════════════════════════════════════
// INIT
// ══════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  initSigPad();
  renderQueue();
  renderDriverList();
  renderHistory();
  showView('v-cargar');
});

// ══════════════════════════════════════
// MODE
// ══════════════════════════════════════
function setMode(m) {
  mode = m;
  document.getElementById('modeOfi').classList.toggle('active', m === 'oficina');
  document.getElementById('modeRep').classList.toggle('active', m === 'repartidor');

  if (m === 'oficina') {
    goBnav('cargar');
  } else {
    goBnav('lista');
  }
}

// ══════════════════════════════════════
// NAV
// ══════════════════════════════════════
function showView(id) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('show'));
  document.getElementById(id).classList.add('show');
}

function goBnav(tab) {
  document.querySelectorAll('.bnav-item').forEach(b => b.classList.remove('on'));
  const map = { cargar: 'bn-carga', lista: 'bn-lista', hist: 'bn-hist' };
  if (map[tab]) document.getElementById(map[tab]).classList.add('on');

  const viewMap = { cargar: 'v-cargar', lista: 'v-lista', hist: 'v-hist' };
  if (viewMap[tab]) showView(viewMap[tab]);
}

// ══════════════════════════════════════
// FILE UPLOAD + AI EXTRACTION
// ══════════════════════════════════════
function handleFiles(evt) {
  const file = evt.target.files[0];
  if (!file) return;

  resetExtract();
  document.getElementById('analyzeStatus').style.display = 'block';
  document.getElementById('btnAgregar').disabled = true;

  // Read file for possible image preview / base64 for AI
  const reader = new FileReader();
  reader.onload = async (e) => {
    const dataUrl = e.target.result;
    await extractWithAI(file.name, dataUrl, file.type);
  };
  reader.readAsDataURL(file);
}

async function extractWithAI(fileName, dataUrl, mimeType) {
  try {
    // Build message content
    const content = [];

    // If it's an image, send as image
    if (mimeType.startsWith('image/')) {
      content.push({
        type: 'image',
        source: { type: 'base64', media_type: mimeType, data: dataUrl.split(',')[1] }
      });
    } else if (mimeType === 'application/pdf') {
      content.push({
        type: 'document',
        source: { type: 'base64', media_type: 'application/pdf', data: dataUrl.split(',')[1] }
      });
    }

    content.push({
      type: 'text',
      text: `Analiza este documento de factura/comprobante y extrae la siguiente información en JSON puro (sin markdown):
{
  "cliente": "nombre del cliente o empresa a quien se entrega",
  "noFactura": "número de factura o folio",
  "direccion": "dirección de entrega si aparece, sino null",
  "monto": "monto total si aparece, sino null"
}
Si no encuentras algún dato, pon null. Solo responde el JSON, nada más.`
    });

    const resp = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 300,
        messages: [{ role: 'user', content }]
      })
    });

    const data = await resp.json();
    let text = data.content?.map(c => c.text || '').join('') || '';
    text = text.replace(/```json|```/g, '').trim();
    const parsed = JSON.parse(text);

    pendingExtract = {
      cliente: parsed.cliente || inferClientFromName(fileName),
      noFactura: parsed.noFactura || fileName.replace(/\.[^.]+$/, ''),
      direccion: parsed.direccion || '',
      monto: parsed.monto || '',
      fileName
    };

  } catch (err) {
    // Fallback: infer from filename
    pendingExtract = {
      cliente: inferClientFromName(fileName),
      noFactura: fileName.replace(/\.[^.]+$/, ''),
      direccion: '',
      monto: '',
      fileName
    };
  }

  showExtracted();
}

function inferClientFromName(name) {
  const n = name.toLowerCase();
  if (n.includes('dportenis') || n.includes('deportenis')) return 'Dportenis';
  if (n.includes('pueblo') || n.includes('bonito')) return 'Pueblo Bonito';
  if (n.includes('petroil') || n.includes('petro')) return 'Petroil';
  return 'Cliente';
}

function showExtracted() {
  document.getElementById('analyzeStatus').style.display = 'none';

  const grid = document.getElementById('extractGrid');
  const e = pendingExtract;
  grid.innerHTML = `
    <div class="extract-item">
      <div class="extract-key">Cliente</div>
      <div class="extract-val">${e.cliente || '—'}</div>
    </div>
    <div class="extract-item">
      <div class="extract-key">No. Factura</div>
      <div class="extract-val mono">${e.noFactura || '—'}</div>
    </div>
    ${e.monto ? `<div class="extract-item">
      <div class="extract-key">Monto</div>
      <div class="extract-val">$${e.monto}</div>
    </div>` : ''}
    <div class="extract-item">
      <div class="extract-key">Archivo</div>
      <div class="extract-val" style="font-size:11px; word-break:break-all">${e.fileName}</div>
    </div>
  `;

  if (e.direccion) document.getElementById('inDireccion').value = e.direccion;

  document.getElementById('extractBox').classList.add('show');
  document.getElementById('btnAgregar').disabled = false;
}

function resetExtract() {
  pendingExtract = null;
  document.getElementById('extractBox').classList.remove('show');
  document.getElementById('analyzeStatus').style.display = 'none';
  document.getElementById('inDireccion').value = '';
  document.getElementById('inNotas').value = '';
  document.getElementById('fileIn').value = '';
  document.getElementById('btnAgregar').disabled = true;
}

// ══════════════════════════════════════
// QUEUE
// ══════════════════════════════════════
function agregarEntrega() {
  if (!pendingExtract) return;

  const entrega = {
    id: Date.now(),
    cliente: pendingExtract.cliente,
    noFactura: pendingExtract.noFactura,
    monto: pendingExtract.monto,
    fileName: pendingExtract.fileName,
    direccion: document.getElementById('inDireccion').value.trim(),
    notas: document.getElementById('inNotas').value.trim(),
    status: 'pending',
    creadaAt: new Date().toISOString(),
  };

  queue.push(entrega);
  saveQueue();
  renderQueue();
  renderDriverList();
  resetExtract();
  toast('✅ Entrega agregada a la ruta', 'ok');
}

function removeFromQueue(id) {
  queue = queue.filter(e => e.id !== id);
  saveQueue();
  renderQueue();
  renderDriverList();
}

function saveQueue() {
  localStorage.setItem('emaz_queue', JSON.stringify(queue));
}

function renderQueue() {
  const list = document.getElementById('queueList');
  const count = queue.length;
  document.getElementById('queueCount').textContent = `${count} entrega${count !== 1 ? 's' : ''}`;

  if (count === 0) {
    list.innerHTML = `<div class="empty"><div class="empty-ico">📭</div><div class="empty-title">Sin entregas cargadas</div><div class="empty-sub">Sube facturas para armar la ruta de hoy</div></div>`;
    return;
  }

  const emojiMap = { 'Dportenis': '🏃', 'Pueblo Bonito': '🏨', 'Petroil': '⛽' };
  const colorMap = { 'Dportenis': '#eff6ff', 'Pueblo Bonito': '#ecfdf5', 'Petroil': '#fef3c7' };

  list.innerHTML = queue.map((e, i) => {
    const em = emojiMap[e.cliente] || '📦';
    const bg = colorMap[e.cliente] || '#f3f4f6';
    const statusHtml = e.status === 'done'
      ? '<span class="status status-done">Firmada ✓</span>'
      : '<span class="status status-pending">Pendiente</span>';
    return `
      <div class="queue-item" style="animation-delay:${i * 0.05}s">
        <div class="qi-dot" style="background:${bg}">${em}</div>
        <div class="qi-info">
          <div class="qi-client">${e.cliente}</div>
          ${e.direccion ? `<div class="qi-meta">📍 ${e.direccion}</div>` : ''}
          <div class="qi-factura">${e.noFactura}</div>
        </div>
        <div class="qi-right">
          ${statusHtml}
          ${e.status !== 'done' ? `<button class="qi-del" onclick="removeFromQueue(${e.id})" title="Eliminar">🗑</button>` : ''}
        </div>
      </div>`;
  }).join('');
}

// ══════════════════════════════════════
// DRIVER LIST
// ══════════════════════════════════════
function renderDriverList() {
  const list = document.getElementById('driverList');
  const total = queue.length;
  const done = queue.filter(e => e.status === 'done').length;
  const pend = total - done;

  document.getElementById('stTotal').textContent = total;
  document.getElementById('stPend').textContent  = pend;
  document.getElementById('stDone').textContent  = done;

  const pw = document.getElementById('progressWrap');
  const pb = document.getElementById('progressBar');
  if (total > 0) {
    pw.style.display = 'block';
    pb.style.width = `${Math.round((done/total)*100)}%`;
  } else { pw.style.display = 'none'; }

  if (total === 0) {
    list.innerHTML = `<div class="empty"><div class="empty-ico">🚚</div><div class="empty-title">No hay entregas para hoy</div><div class="empty-sub">Pide a oficina que cargue las facturas</div></div>`;
    return;
  }

  const emojiMap = { 'Dportenis': '🏃', 'Pueblo Bonito': '🏨', 'Petroil': '⛽' };

  list.innerHTML = queue.map((e, i) => {
    const em = emojiMap[e.cliente] || '📦';
    const isDone = e.status === 'done';
    return `
      <div class="dlv-item${isDone ? ' done' : ''}" onclick="${isDone ? '' : `openSign(${e.id})`}">
        <div class="dlv-top">
          <div class="dlv-num${isDone ? ' done' : ''}">${isDone ? '✓' : (i+1)}</div>
          <div style="flex:1; min-width:0">
            <div class="dlv-client">${em} ${e.cliente}</div>
            ${e.direccion ? `<div class="dlv-addr">📍 ${e.direccion}</div>` : ''}
            <div class="dlv-fac">${e.noFactura}</div>
          </div>
          <div class="dlv-arrow">${isDone ? '✅' : '›'}</div>
        </div>
      </div>`;
  }).join('');
}

// ══════════════════════════════════════
// SIGN FLOW
// ══════════════════════════════════════
function openSign(id) {
  activeDelivery = queue.find(e => e.id === id);
  if (!activeDelivery) return;

  const emojiMap = { 'Dportenis': '🏃', 'Pueblo Bonito': '🏨', 'Petroil': '⛽' };
  document.getElementById('signClientTitle').textContent = `${emojiMap[activeDelivery.cliente] || '📦'} ${activeDelivery.cliente}`;
  document.getElementById('signClientSub').textContent = activeDelivery.direccion || 'Sin dirección especificada';

  const summary = document.getElementById('signSummary');
  const now = new Date();
  summary.innerHTML = `
    <div class="ss-row"><span class="ss-k">Factura</span><span class="ss-v mono">${activeDelivery.noFactura}</span></div>
    ${activeDelivery.monto ? `<div class="ss-row"><span class="ss-k">Monto</span><span class="ss-v">$${activeDelivery.monto}</span></div>` : ''}
    ${activeDelivery.direccion ? `<div class="ss-row"><span class="ss-k">Dirección</span><span class="ss-v">${activeDelivery.direccion}</span></div>` : ''}
    ${activeDelivery.notas ? `<div class="ss-row"><span class="ss-k">Notas</span><span class="ss-v">${activeDelivery.notas}</span></div>` : ''}
    <div class="ss-row"><span class="ss-k">Fecha y hora</span><span class="ss-v">${now.toLocaleDateString('es-MX')} ${now.toLocaleTimeString('es-MX', {hour:'2-digit',minute:'2-digit'})}</span></div>
  `;

  document.getElementById('inReceptor').value = '';
  clearSig();
  document.getElementById('signStepA').style.display = 'block';
  document.getElementById('signStepB').style.display = 'none';
  showView('v-sign');
  window.scrollTo({ top: 0 });
}

function goSignB() {
  const receptor = document.getElementById('inReceptor').value.trim();
  if (!receptor) { toast('⚠️ Ingresa el nombre del receptor', 'err'); return; }
  document.getElementById('signStepA').style.display = 'none';
  document.getElementById('signStepB').style.display = 'block';
  window.scrollTo({ top: 0 });
}

function backToSignA() {
  document.getElementById('signStepA').style.display = 'block';
  document.getElementById('signStepB').style.display = 'none';
}

function confirmarFirma() {
  if (!hasSig) { toast('⚠️ El receptor debe firmar primero', 'err'); return; }

  const now = new Date();
  const receptor = document.getElementById('inReceptor').value.trim();
  const emojiMap = { 'Dportenis': '🏃', 'Pueblo Bonito': '🏨', 'Petroil': '⛽' };

  const record = {
    ...activeDelivery,
    receptor,
    firma: sigData,
    entregadaAt: now.toISOString(),
    fechaStr: now.toLocaleDateString('es-MX', { day:'2-digit', month:'long', year:'numeric' }),
    horaStr: now.toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit' }),
  };

  // Mark done in queue
  const idx = queue.findIndex(e => e.id === activeDelivery.id);
  if (idx >= 0) { queue[idx].status = 'done'; saveQueue(); }

  // Save to history
  history.unshift(record);
  localStorage.setItem('emaz_history', JSON.stringify(history));

  // Show success
  document.getElementById('so-receipt').innerHTML = `
    <div class="so-row"><span class="so-key">Cliente</span><span class="so-val">${emojiMap[record.cliente] || '📦'} ${record.cliente}</span></div>
    <div class="so-row"><span class="so-key">Receptor</span><span class="so-val">${receptor}</span></div>
    <div class="so-row"><span class="so-key">Factura</span><span class="so-val mono">${record.noFactura}</span></div>
    <div class="so-row"><span class="so-key">Fecha</span><span class="so-val">${record.fechaStr}</span></div>
    <div class="so-row"><span class="so-key">Hora</span><span class="so-val">${record.horaStr}</span></div>
  `;

  document.getElementById('successOv').classList.add('show');
  renderDriverList();
  renderQueue();
  renderHistory();
}

function closeSuccess() {
  document.getElementById('successOv').classList.remove('show');
  goBnav('lista');
}

// ══════════════════════════════════════
// PDF RECEIPT DOWNLOAD
// ══════════════════════════════════════
function downloadReceipt() {
  if (!activeDelivery) return;

  const { jsPDF } = window.jspdf;
  if (!jsPDF) { toast('⚠️ Cargando librería, intenta de nuevo', 'err'); return; }

  const receptor = document.getElementById('inReceptor').value.trim();
  const now = new Date();
  const rec = {
    ...activeDelivery,
    receptor,
    fechaStr: now.toLocaleDateString('es-MX', { day:'2-digit', month:'long', year:'numeric' }),
    horaStr: now.toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit' }),
  };

  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
  const W = 210, margin = 18;
  let y = 20;

  // ── Header bar ──
  doc.setFillColor(13, 17, 23);
  doc.roundedRect(margin, y, W - margin*2, 18, 3, 3, 'F');
  doc.setTextColor(245, 158, 11);
  doc.setFontSize(13); doc.setFont('helvetica', 'bold');
  doc.text('EntregasMaz', margin + 5, y + 7);
  doc.setTextColor(180, 180, 180);
  doc.setFontSize(8); doc.setFont('helvetica', 'normal');
  doc.text('Mazatlan, Sinaloa  |  Comprobante de Entrega', margin + 5, y + 13);
  y += 26;

  // ── Title ──
  doc.setTextColor(13, 17, 23);
  doc.setFontSize(18); doc.setFont('helvetica', 'bold');
  doc.text('Comprobante de Entrega', margin, y);
  y += 5;
  doc.setDrawColor(245, 158, 11);
  doc.setLineWidth(1);
  doc.line(margin, y, margin + 80, y);
  y += 10;

  // ── Details table ──
  const rows = [
    ['Cliente',   rec.cliente],
    ['No. Factura', rec.noFactura],
  ];
  if (rec.monto)     rows.push(['Monto', `$${rec.monto}`]);
  if (rec.direccion) rows.push(['Direccion', rec.direccion]);
  rows.push(['Receptor', rec.receptor]);
  rows.push(['Fecha', rec.fechaStr]);
  rows.push(['Hora', rec.horaStr]);
  if (rec.notas) rows.push(['Notas', rec.notas]);

  rows.forEach(([k, v], i) => {
    const bg = i % 2 === 0;
    if (bg) {
      doc.setFillColor(249, 250, 251);
      doc.rect(margin, y - 4, W - margin*2, 9, 'F');
    }
    doc.setFontSize(9); doc.setFont('helvetica', 'normal');
    doc.setTextColor(107, 114, 128);
    doc.text(k, margin + 3, y + 1);
    doc.setFont('helvetica', 'bold');
    doc.setTextColor(13, 17, 23);
    doc.text(String(v), margin + 55, y + 1);
    y += 9;
  });

  y += 8;

  // ── Signature ──
  doc.setFontSize(9); doc.setFont('helvetica', 'bold');
  doc.setTextColor(107, 114, 128);
  doc.text('FIRMA DEL RECEPTOR', margin, y);
  y += 4;

  if (sigData) {
    try {
      doc.addImage(sigData, 'PNG', margin, y, 80, 35);
      y += 40;
    } catch(e) {
      doc.setDrawColor(229, 231, 235);
      doc.setLineWidth(0.5);
      doc.roundedRect(margin, y, 80, 35, 2, 2);
      y += 40;
    }
  } else {
    doc.setDrawColor(229, 231, 235);
    doc.setLineWidth(0.5);
    doc.roundedRect(margin, y, 80, 30, 2, 2);
    y += 35;
  }

  // ── Footer ──
  doc.setFontSize(8); doc.setFont('helvetica', 'normal');
  doc.setTextColor(156, 163, 175);
  doc.text(`Generado: ${now.toLocaleString('es-MX')}`, margin, 285);
  doc.text('EntregasMaz v2.0', W - margin, 285, { align: 'right' });

  const filename = `comprobante-${rec.cliente.replace(/\s+/g,'_')}-${rec.noFactura}.pdf`;
  doc.save(filename);
  toast('📥 PDF descargado', 'ok');
}

